# --- Branding / fleet scope (this deployment serves one customer) ---
# Shown in the topbar, page titles, and login page; also the keyword used to pick
# the customer's fleets out of the VSS fleet tree and MiX site names.
FLEET_BRAND_NAME=Alliad
FLEET_VSS_CONTAINS=Alliad
# FLEET_BRAND_TAGLINE=Fleet Health
# FLEET_BRAND_SUBTITLE=Alliad · VSS · MiX · Track3
# Logo files served from assets/: the full logo is used on light surfaces (login
# card), the mark alone on the dark nav bar. Colours live in assets/flask-theme.css.
# FLEET_LOGO_FILE=alliad_logo.svg
# FLEET_MARK_FILE=alliad_mark.svg

# --- VSS API (required for fleet data) ---
# The app tries each complete profile in order until apiLogin succeeds (status 10000).
# Primary profile:
VSS_BASE_URL=http://40.76.130.233:9966
VSS_USERNAME=your@vss-user
VSS_PASSWORD=your-password

# Secondary profile (_N suffix) — e.g. https://vss.controltech-ea.com (see howen_vss_api.ipynb):
# VSS_BASE_URL_N=https://vss.controltech-ea.com
# VSS_USERNAME_N=your@vss-user
# VSS_PASSWORD_N=your-password

# SSL verify for HTTPS VSS hosts (default off for controltech-ea.com, matches notebook verify=False):
# VSS_SSL_VERIFY=0

# Proactive token refresh: token + PID are reused for this many hours (default 22).
# Neon is the source of truth when configured; local JSON token fallback is disabled.
# VSS_TOKEN_TTL_HOURS=22
# When the stored token is older than this, the app apiLogs in via .env, overwrites Neon, and uses the new token.
# Set VSS_10082_RETRY_LOGIN=1 to force login retries even when a token file exists (recovery uses this automatically).

# --- Postgres (Neon or Supabase) — VSS token, snapshots, operation logs ---
# The app reads NEON_DB_URL first; DATABASE_URL and SUPABASE_DB_URL also work.
# Supabase: Project Settings → Database → Connection string → URI (Session mode).
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# NEON_DB_URL=postgresql://user:password@host/dbname?sslmode=require
# Run once on new database: scripts/supabase_setup.sql (SQL Editor) or python scripts/setup_supabase_db.py
# Push to Vercel: set NEON_DB_URL in .env then python scripts/push_db_url_vercel.py
# Local API testing: python scripts/vss_token_from_neon.py --postman
# Fleet probe:       python scripts/vss_probe_fleet.py --contains BUILDER --print-token
# Optional overrides:
# NEON_VSS_TOKEN_TABLE=vss_tokens
# NEON_VSS_TOKEN_ID=active
# Give every customer deployment its own tables (the VSS token row can stay shared
# so two dashboards do not trip VSS error 10082 "login too frequently").
# NEON_SNAPSHOT_TABLE=alliad_snapshots
# NEON_META_TABLE=alliad_meta
# NEON_OPERATION_LOG_TABLE=alliad_operation_logs
# NEON_OPERATION_SESSIONS_TABLE=alliad_operation_sessions
# NEON_SNAPSHOT_MAX_HOURS=168
# Keep production pages fast by rendering cached/snapshot data instead of blocking on live VSS pulls.
# DHL_SYNC_LOAD_ON_PAGE=0

# --- Flask dashboard login (separate from VSS credentials) ---
# FLASK_SECRET_KEY=change-me-in-production
# DHL_DASH_USERNAME=admin
# DHL_DASH_PASSWORD=dhl

# Alarm history: default is legacy findAllByTime (matches most deployments). V2.8 doc endpoint:
# VSS_ALARM_FIND_PATH=/vss/alarm/apiFindAllByTime.action

# Optional: paste a known-good token to skip login (avoids 10082 rate limit on cold start).
# VSS_TOKEN=
# VSS_PID=

# Umbrella customer fleet in VSS (copy GUID from the fleet tree). Crawls that fleet + all child fleets.
# (DHL_* names below are historical internal names; they apply to whichever customer this deployment serves.)
# DHL_ROOT_FLEET_ID=
# Or explicit list: DHL_FLEET_IDS=guid-one,guid-two
# DHL_FLEET_IDS=
# If env fleets are set but /vehicle/findAll returns no rows, keyword scan is skipped (set 1 to force old behavior):
# DHL_ALLOW_KEYWORD_DEVICE_FALLBACK=1

# Dashboard bind (dev: python flask_app.py)
# Werkzeug HTTP access log (every Dash poll): default off; set 1 to print each request.
# DHL_DASH_ACCESS_LOG=1
# Background bust + refetch interval (minutes). Default 60 = 1 hour; matches data cache TTL.
# DHL_AUTO_REFRESH_MINUTES=60
# Realtime snapshot auto-refresh (minutes). Default 30. Set 0 to disable.
# On Vercel Pro, vercel.json runs GET /api/cron/realtime every 30 minutes.
# Local Flask starts a background thread. Uses the stored Neon token; may
# apiLogin once if that token is dead.
# DHL_REALTIME_AUTO_REFRESH_MINUTES=30
# Vercel sends this as Authorization: Bearer … on cron requests. Required in production.
# CRON_SECRET=
# DHL_DASH_HOST=127.0.0.1
# Dev server default port is 8050 (see DEFAULT_PORT in flask_app.py).
DHL_DASH_PORT=8050

# docker compose: host port (default 8050) -> container 8050
# DHL_PUBLISH_PORT=8050

# UI polls caches every N ms so charts appear soon after data arrives (default 1000).
# DHL_UI_POLL_MS=1000
# Parallel fleet device pages during crawl (default 10, max 16 in code).
# DHL_DEVICE_FLEET_WORKERS=10
# Default -1 = poll forever; was 300 (~10 min) then charts could stay "No data" if VSS was slower.
# DHL_UI_POLL_MAX_TICKS=-1

# --- Load speed ---
# Seed devices from the last good snapshot immediately, then refresh realtime/alarms in background.
# This makes the dashboard paint fast even while VSS live calls are still warming.
# DHL_SEED_DEVICES_FROM_SNAPSHOT=1
# Default in code is FAST (keyword device list + shorter alarm window). For full crawl + 24h alarms:
# DHL_FAST_MODE=0
# DHL_FAST_ALARM_HOURS=2
# DHL_FAST_SKIP_ALARMS=1
# DHL_FAST_ALARM_WORKERS=4
# DHL_FAST_ALARM_MAX_PAGES=10
# Proper device crawl is fleet-based (recommended). Keyword-only is opt-in:
# DHL_FAST_DEVICE_KEYWORD_ONLY=1
# DHL_FAST_DEVICE_MAX_PAGES=25
# DHL_FAST_DEVICE_FLEET_WORKERS=6
# Optional overrides (keep max_workers <= 12 unless you know the server can take more).
# DHL_REALTIME_BATCH=10
# DHL_REALTIME_MAX_WORKERS=8

# Default: server listens immediately; data loads in background. Set 1 only to block until devices are cached.
# DHL_SYNC_BOOTSTRAP=1
# Seconds before HTTP starts even if the device list is still loading. Default 120.
# DHL_BOOTSTRAP_TIMEOUT_SEC=120

# After a successful load, device list is saved to .dhl_devices_snapshot.csv and reused if VSS fails (10082, etc.).
# DHL_DEVICE_SNAPSHOT_DISABLE=1
# DHL_DEVICE_SNAPSHOT_MAX_HOURS=168
# Use CSV as the device baseline (DeviceID / DeviceName / FleetID / Fleet) and skip VSS discovery;
# realtime + alarms still call VSS with those DeviceIDs. Path defaults to repo .dhl_devices_snapshot.csv.
# DHL_DEVICES_FROM_SNAPSHOT=1
# DHL_DEVICE_SNAPSHOT_PATH=C:\Users\Paul\Downloads\dhl_dashboard\.dhl_devices_snapshot.csv

# Jupyter positions.ipynb: if kernel cwd is not dhl_dashboard, set this to the repo folder.
# DHL_DASHBOARD_DIR=C:\Users\Paul\Downloads\dhl_dashboard

# --- MiX Telematics (optional) ---
# Enable MiX positions page + background refresh:
# MIX_ENABLED=1
# Preferred: inline JSON (same shape as accounts.json) — no file needed:
# MIX_ACCOUNTS_JSON={"mix_za":{"ApiUrl":"https://...","IdentityUrl":"...","IdentityClientId":"...","IdentityClientSecret":"...","IdentityUsername":"...","IdentityPassword":"..."}}
# AGL fleet login: client AfricaGlobalLogisticsKenya is rejected by MiX (invalid_client). Use IdentityClientId
# integrate.za.rg + ControlTech client secret + AGL IdentityUsername/Password — see postman/MIX_ACCOUNTS_agl_user.example.json
# Or path to accounts.json (default: ./accounts.json in this folder). Copy accounts.json.example first.
# MIX_ACCOUNTS_JSON_PATH=accounts.json
# Key inside accounts.json (default mix_za for DHL / East Africa fleet):
# MIX_SERVER_KEY=mix_za
# Comma-separated MiX group IDs — Alliad site under EABL:
# MIX_GROUP_IDS=2751326493625476525
# Or pull every matching site under a parent organisation instead of listing ids:
# MIX_PARENT_ORG_ID=1058674603567860796
# MIX_SITE_PREFIX=Alliad
# Or match by organisation name instead of id:
# MIX_PARENT_ORG_CONTAINS=Diageo
# MIX_SITE_PREFIX=Alliad
# MiX organisation id for library events API (not the site/group id in MIX_GROUP_IDS)
# MIX_ORGANISATION_ID=1058674603567860796
# Substring match on organisation group names (legacy fallback if MIX_PARENT_ORG_CONTAINS is unset):
# MIX_GROUP_NAME_CONTAINS=Alliad
# Pull every organisation group your MiX user can access:
# MIX_FETCH_ALL_GROUPS=1
# MIX_QUANTITY=1
# MIX_ENSURE_REVERSE_GEOCODED=1
# Enrich positions with asset name + registration (default ON; set 0 to skip extra API call):
# MIX_FETCH_ASSETS=1
# Display timezone offset hours for "Last updated" (default 3 = East Africa):
# MIX_DISPLAY_TZ_OFFSET_HOURS=3
#
# Or inline credentials (skip accounts.json):
# MIX_API_URL=
# MIX_IDENTITY_URL=
# MIX_CLIENT_ID=
# MIX_CLIENT_SECRET=
# MIX_USERNAME=
# MIX_PASSWORD=
# Speed + RPM from MiX tacho API (F1 = speed km/h, F2 = RPM on DHL devices).
# MIX_TACHO_ENRICH_POSITIONS=1
# MIX_TACHO_MINUTES=59
# MIX_TACHO_SPEED_LINE=F1
# MIX_TACHO_RPM_LINE=F2
# MiX: 7-day "Diagnostic fault no engine RPM" event scan (library + group events API)
# MIX_RPM_FAULT_DAYS=7
# MIX_RPM_FAULT_EVENT_MATCH=diagnostic fault no engine rpm,no engine rpm,fault no engine rpm
# Or set explicit EventTypeIds from /api/libraryevents/organisation/{groupId}:
# MIX_RPM_FAULT_EVENT_TYPE_IDS=
# Light mode (auto when >25 DHL sites): inventory only unless RPM diag enabled (default ON in light mode)
# MIX_HEALTH_LIGHT=1
# MIX_HEALTH_RPM_DIAG=1
# MIX_HEALTH_COMM_CHECK=1
# MIX_HEALTH_POS_BATCH=20
# MIX_HEALTH_POS_WORKERS=6
# MIX_RPM_EVENT_GROUP_BATCH=25

# --- Track3 (Wialon Hosting) ---
# Long-lived API token; exchanged for a short-lived session id on each cold start.
TRACK3_ENABLED=1
# TRACK3_TOKEN=your-wialon-api-token
# TRACK3_BASE_URL=https://hst-api.wialon.com
# Unit group and the resource that owns reports (Alliad group = 78 units):
# TRACK3_GROUP_ID=28475360
# TRACK3_GROUP_NAME=Alliad
# TRACK3_RESOURCE_ID=28462319
# Last-message age (minutes) that still counts as Online:
# TRACK3_ONLINE_MINUTES=30

# --- Driver behaviour (over speeding, harsh acceleration / braking / cornering) ---
# Track3 eco-driving report window, in hours:
# TRACK3_BEHAVIOUR_HOURS=24
# Cap the number of vehicles read back from the report (0 = all):
# TRACK3_REPORT_MAX_UNITS=0
# MiX events window, in hours (API allows 7 days per request; longer windows are chunked):
# MIX_BEHAVIOUR_HOURS=24
# Skip library-catalogue matching by listing EventTypeIds explicitly:
# MIX_BEHAVIOUR_EVENT_TYPE_IDS=
