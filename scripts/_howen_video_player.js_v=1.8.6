    /**
     * 单个播放
     */
    playsingle: function (index) {
        let that = this;
        let {
            flvPlayer,
            url
        } = that.vediowindows[index];
        let newUrl = "";
        //当前是回放需要处理时间问题
        if (url.indexOf("replay") >= 0) {
            console.log(url);

            let arr_url = url.split("_");
            if (flvPlayer.OldTime) {
                flvPlayer.OldTime += flvPlayer.currentTime;
            } else flvPlayer.OldTime = flvPlayer.currentTime;
            let newDate = parseInt(arr_url[3]) + flvPlayer.OldTime;

            let year = arr_url[3].substring(0, 4);
            let month = arr_url[3].substring(4, 6);
            let day = arr_url[3].substring(6, 8);
            let hour = arr_url[3].substring(8, 10);
            let min = arr_url[3].substring(10, 12);
            let s = arr_url[3].substring(12, 14);
            let temp = +new Date(
                year + "/" + month + "/" + day + " " + hour + ":" + min + ":" + s
            );
            temp += flvPlayer.OldTime * 1000;
            arr_url[3] = formatDate(temp);
            newUrl = arr_url.join("_").replace("replay?", "_bywasm_replay?");

            flvPlayer.unload();
        }
        flvPlayer.play(newUrl);
