    /**
     * 回放倍数选择
     * @param {*} index 
     * @param {*} speed 
     */
    speed: function (index, speed) {

        let that = this;
        index += 1;
        let {
            url,
            deviceno,
            channel,
            isfree,
            flvPlayer,
            channelName,
            totalTime,
        } = that.vediowindows[index - 1];


        function formatDate(date) {
            var date = new Date(date);
            var YY = date.getFullYear() + "";
            var MM =
                (date.getMonth() + 1 < 10 ? "0" + (date.getMonth() + 1) : date.getMonth() + 1) + "";
            var DD = date.getDate() < 10 ? "0" + date.getDate() : date.getDate();
            var hh = (date.getHours() < 10 ? "0" + date.getHours() : date.getHours()) + "";
            var mm = (date.getMinutes() < 10 ? "0" + date.getMinutes() : date.getMinutes()) + "";
            var ss = date.getSeconds() < 10 ? "0" + date.getSeconds() : date.getSeconds();
            return YY + MM + DD + hh + mm + ss;
        }


        //停止当前流。开启新的流
        if (flvPlayer) {
            try {
                totalTime += parseInt(flvPlayer.currentTime) * speed;

                flvPlayer.pause();
                flvPlayer.unload();
                flvPlayer.detachMediaElement();
                flvPlayer.destroy();
            } catch (err) { }
        }

        let cur_speed;

        if (isfree) return;

        switch (speed) {
            case 1:
                $(that.ele + " .tv_video_item_" + index + " .tv_video_speed").hide();
                $(this).next().show();
                cur_speed = 2;
                break;
            case 2:
                $(that.ele + " .tv_video_item_" + index + " .tv_video_speed").hide();

                $(this).next().show();
                cur_speed = 4;
                break;
            case 4:
                $(that.ele + " .tv_video_item_" + index + " .tv_video_speed").hide();
                $($(that.ele + " .tv_video_item_" + index + " .tv_video_speed")[0]).show();
                cur_speed = 1;
                break;
            default:
                break;
        }
        let hasAudio = true;
        let tempurl = url.split("_");
        that.vediowindows[index - 1].totalTime = totalTime;
        let year = tempurl[3].substring(0, 4);
        let month = tempurl[3].substring(4, 6);
        let day = tempurl[3].substring(6, 8);
        let hour = tempurl[3].substring(8, 10);
        let min = tempurl[3].substring(10, 12);
        let s = tempurl[3].substring(12, 14);

        let temp = +new Date(year + "/" + month + "/" + day + " " + hour + ":" + min + ":" + s);

        temp += totalTime * 1000;

        tempurl[3] = formatDate(temp);
        if (cur_speed == 1) {
            tempurl[0] = tempurl[0].replace("fastReplay", "replay");
        } else {
            tempurl[0] = tempurl[0].replace("replay", "fastReplay");
            tempurl.push(cur_speed);
            hasAudio = false;
        }

        url = tempurl.join("_");
        url = url.replace('_bywasm_', ''); //控制权交给flv
        that.play(index - 1, url, deviceno, channel, channelName, "", hasAudio, cur_speed);

    },

