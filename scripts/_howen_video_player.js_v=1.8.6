     * @param {*} index 窗口索引
     */
    stop: function (index) {

        let that = this;

        that.vediowindows[index].isfree = true;
        that.vediowindows[index].totalTime = 0;
        let {
            flvPlayer,
            url,
            filename
        } = that.vediowindows[index];

        let port = url.split(/[/,:]/)[4];
        if (port) {
            that.httpsPorts.forEach((d) => {
                if (d.port == port) {
                    d.count -= 1;
                }
            });
        }

        if (flvPlayer) {
            try {
                flvPlayer.pause();
                flvPlayer.unload();
                flvPlayer.detachMediaElement();
                flvPlayer.destroy();
            } catch (err) { }
        }

        if (that.vediowindows[index].iscanvas == true) {
            let box = $(that.ele + "videoElement" + (index + 1)).parent();
            box.html("");
            box.append(
                '<video id="videoElement' + (index + 1) + '" autoplay muted="true"></video>'
            );
        }
        that.vediowindows[index].iscanvas = false;
        that.vediowindows[index].flvPlayer = null;

        let _$ = $('.tv_video_stop' + "[data-index='" + (index + 1) + "']");
        _$.parent().prev().css("background", "url(image/logo2.png) no-repeat center center");
        _$.parent().find(".tv_video_item_box_ch").html("");
        // 暂停按钮也取消掉
        _$.next().hide();
        _$.next().next().hide();
        _$.hide();

        //倍速回到一倍速

        $(that.ele + " [data-index='" + (index + 1) + "']").filter('.tv_video_speed').hide();

        if (that.isBackPlay) {
            $(that.ele + " [data-index='" + (index + 1) + "']").filter('.tv_video_speed_1').show();
        }



        //这里主要处理告警录像列表播放时有选中状态，在这里取消

        if (filename) {
            $(".layui-table-cell:contains('" + filename + "')").parent().parent().removeClass('playing');
        }
    },

