    /**
     * 停止所有视频
     */
    stopAllVideo: function stopAllVideo() {
        $(this.ele + " .tv_video_item_box_video").css("background", "");
        $(this.ele + " .tv_video_pause").hide();
        $(this.ele + " .tv_video_stop").hide();
        $(this.ele + " .tv_video_vehicle_stop").hide();
        $(this.ele + " .tv_video_item_box_ch").html("");
        for (let index = 0; index < this.windowsCount; index++) {
            this.vediowindows[index].isfree = true;
            let flvPlayer = this.vediowindows[index].flvPlayer;
            if (flvPlayer) {
                try {
                    flvPlayer.pause();
                    flvPlayer.unload();
                    flvPlayer.detachMediaElement();
                    flvPlayer.destroy();
                } catch (err) { }
            }
            if (this.vediowindows[index].iscanvas == true) {
                let box = $(this.ele + "videoElement" + (index + 1)).parent();
                box.html("");
                box.append(
                    '<video id="videoElement' + (index + 1) + '" autoplay muted="true"></video>'
                );
            }
            this.vediowindows[index].iscanvas = false;
            this.vediowindows[index].flvPlayer = null;
            this.vediowindows[index].totalTime = 0;
            this.vediowindows[index].url = '';
        }
        $(this.ele + " .tv_video_item_box_video").css(
            "background",
            "url(image/logo2.png) no-repeat center center"
        );
        //重置Https连接数量
        this.httpsPorts.forEach((element) => {
            element.count = 0;
        });

    },
    /**
     * 暂停所有视频
     */
    pauseAll: function () {
        for (let index = 0; index < this.windowsCount; index++) {
            this.vediowindows[index].isfree = true;
            if (!this.vediowindows[index].flvPlayer) continue;
            this.vediowindows[index].flvPlayer.pause();
            if (this.vediowindows[index].channel != -1) {
                $(this.ele + " .tv_video_item_" + (index + 1) + " .tv_video_play").show();
            }
        }
        $(this.ele + " .tv_video_pause").hide();
    },

    /**
     * 回放时，所有的回到一倍速
     */
    playBack_1x: function playBack_1x() {
        $(this.ele + " .tv_video_speed").hide();
    },
    /**
     * 初始化窗口数量
     */
    initVideoWindow: function (count) {
        this.windowsCount = count > 0 ? count : this.windowsCount;
        // 是否开启 video窗口展示数量 本地存储
        if (this.storageWinCount) {
            // 获取 文件名
            let htmlName = window.location.pathname.match(/\/(\S*)\./)[1]
            let storageName = htmlName + '_windowsCount'
            localStorage.setItem(storageName, this.windowsCount);
        }
        //初始化窗口数量
        $(this.ele + " .tv_video").css("display", "inline");
        $(this.ele + " .tv_video_item").css("height", "");
        $(this.ele + " .tv_video_item").css("width", "");
        $(this.ele + " .tv_video_item").css("float", "");
        $(this.ele + " .tv_video_item").css("display", "none");
        $(this.ele + " .tv_video_item_4").css("clear", "");

        let h = $(".tv_video").height();
        let _h;

        switch (this.windowsCount) {
            case 1: //1 个窗口

                //_h = h + "px";
                _h = "100%";
                $(this.ele + " .tv_video_item_1").css("width", "100%");
                // $(".tv_video_item_1").css('float', '');
                $(this.ele + " .tv_video_item_1").css("display", "");
                $(this.ele + " .tv_video_item_1").css("height", _h);
                //$(".tv_video").css('display', 'inline');
                break;
            case 4: // 4个窗口
                //_h = h / 2 + "px";
                _h = "50%";
                $(this.ele + " .tv_video_item_1").css("display", "inline");
                $(this.ele + " .tv_video_item_2").css("display", "inline");
                $(this.ele + " .tv_video_item_3").css("display", "inline");
                $(this.ele + " .tv_video_item_4").css("display", "inline");

                $(this.ele + " .tv_video_item_1").css("height", _h);
                $(this.ele + " .tv_video_item_1").css("width", "50%");
                $(this.ele + " .tv_video_item_1").css("float", "left");

                $(this.ele + " .tv_video_item_2").css("height", _h);
                $(this.ele + " .tv_video_item_2").css("width", "50%");
                $(".tv_video_item_2").css("float", "left");

                $(this.ele + " .tv_video_item_3").css("height", _h);
                $(this.ele + " .tv_video_item_3").css("width", "50%");
                $(".tv_video_item_3").css("float", "left");

                $(this.ele + " .tv_video_item_4").css("height", _h);
                $(this.ele + " .tv_video_item_4").css("width", "50%");
                $(this.ele + " .tv_video_item_4").css("float", "left");
                break;
            case 6: // 6个窗口
                // _h = h / 3 + "px";
                // let _h2 = 2 * (h / 3) + "px";

                _h = "33.33%";
                let _h2 = "66.66%";


                $(this.ele + " .tv_video_item_1").css("display", "inline");
                $(this.ele + " .tv_video_item_2").css("display", "inline");
                $(this.ele + " .tv_video_item_3").css("display", "inline");
                $(this.ele + " .tv_video_item_4").css("display", "inline");
                $(this.ele + " .tv_video_item_5").css("display", "inline");
                $(this.ele + " .tv_video_item_6").css("display", "inline");

                $(this.ele + " .tv_video_item_1").css("height", _h2);
