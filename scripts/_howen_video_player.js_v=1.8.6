                $('.tv_video_speed_1').show();
            }

            //这里主要处理告警录像列表播放时有选中状态，在这里取消
            $('.playing').removeClass('playing');
        });

        // 全部暂停按钮
        $(that.ele + " #pauseAll").click(function () {
            that.pauseAll();
        });


        //双击全屏
        var touchtime = 0;
        $(that.ele + ' .tv_video_item_box_video').on("click", function () {
            if (touchtime == 0) {
                // set first click
                touchtime = new Date().getTime();
            } else {
                // compare first click to this click and see if they occurred within double click threshold
                if (((new Date().getTime()) - touchtime) < 500) {
                    // double click occurred
                    $(this).parent().find('.tv_video_item_box_full').click();
                    touchtime = 0;
                } else {
                    // not a double click so set as a new first click
                    touchtime = new Date().getTime();
                }
            }
        });

        //双击全屏
        // $(that.ele + ' .tv_video_item_box_video').dblclick(function() {

        //     $(this).parent().find('.tv_video_item_box_full').click();

        // });

        //实时/流畅
        $(that.ele + ' .playmode').click(function () {
            if ($(this).hasClass('tv_control_font_hover') == false) {
                return;
            }

            if ($(this).hasClass('real')) {
                $(this).removeClass('real').html('&#xe672;').attr('title', sessionStorage.getItem('SMOOTHFIRST'))
                that.mBufferTimeMs = 2000;
                return;
            }
            that.mBufferTimeMs = 0;
            $(this).addClass('real').html('&#xe6ce;').attr('title', sessionStorage.getItem('REALFIRST'))
        })

        //全部播放按钮
        $(that.ele + " #playAll").click(function () {
            if ($(this).hasClass('tv_control_font_hover') == false) {
                return;
            }

            $(that.ele + " .tv_video_play").hide();
            for (let index = 0; index < that.windowsCount; index++) {
                if (!that.vediowindows[index].flvPlayer) return;
                if (that.vediowindows[index].channel != -1) {
                    $(that.ele + " .tv_video_item_" + (index + 1) + " .tv_video_pause").show();
                    $(that.ele + " .tv_video_item_" + (index + 1) + " .tv_video_stop").show();
                    $(that.ele + " .tv_video_item_" + (index + 1) + " .tv_video_vehicle_stop").show();
                }
                that.vediowindows[index].isfree = true;
                that.vediowindows[index].flvPlayer.resumePlaying();
                // let videoElement = document.getElementById(that.vediowindows[index].id);
                // videoElement.play();
            }
            $(that.ele + " #stopAll").show();
        });

        //全屏
        $(that.ele + " #winFullscreen").click(function () {
            that.winFullscreen();
        });


        //截屏
        $(that.ele + " .tv_video_item_camera").click(function () {


            let canvas = $(this).parent().prev().find('canvas');
            if (canvas.length > 0) {
                let img = $.canvasToImage(canvas[0]);
                that.cameraData = img.src;
                sessionStorage.setItem('cameraData', img.src)
                //$.imageDownLoad(img);
                layer.open({
                    type: 2,
                    title: sessionStorage.getItem('PICTUREPROCESSING') || 'Picture processing',
                    fixed: false, //不固定
                    maxmin: true,
                    area: ['1100px', '700px'],
                    content: 'howen_ps.html?v=1.8.6'
                });
            }


        });


        $(window).resize(function () {


            setTimeout(function () {
                let ismax = $(that.ele + " .tv_video").data("ismaxwin");
                if (ismax) {
                    $(that.ele + " .tv_video_item:visible").css("height", "");
                    let h = $(that.ele + " .tv_video").height() + "px";

                    $(that.ele + " .tv_video_item:visible").css("height", h);
                } else {
                    that.initVideoWindow(this.windowsCount);
                    $(that.ele + " .tv_video").data("ismaxwin", false);
                }
                that.changeCanvas();
            }, 200)



        });

        //TODO v.7 PZT 改造


        $(document).on('click', '.tv_video_item', function () {
            let index = $(this).find('.tv_video_item_box').attr('data-index');
            let {
                isfree,
                channel,
                deviceno
            } = that.vediowindows[index];
            if (isfree) return;
            $('.tv_video_item').removeClass('tv_video_item_selected')
            $(this).addClass('tv_video_item_selected');
            that.selectedChange && that.selectedChange(deviceno, channel);
            that.changeCanvas();
        })


        //TODO V1.7  这里检测60s不操作时， 主动关闭视频

        let currtentTime = new Date().getTime(),
            lastTime = new Date().getTime(),
            diff = (localStorage.getItem('seting_closevideovalue') ? parseInt(localStorage.getItem('seting_closevideovalue')) : 1000) * 1000;
        $(document).on('mouseover', function () {
            lastTime = new Date().getTime();
        });
        let timer = setInterval(function () {
            currentTime = new Date().getTime();
            if (currentTime - lastTime > diff) {
                that.stopAllVideo();
                lastTime = new Date().getTime();
                //clearInterval(timer);
            }
        }, 1);


        //TODO V1.7 这里是右键菜单


        function videoContextClick(treeid, key, $selector) {
            let v = $selector,
                ele;

            let i = v.attr('data-index');
            // switch (key) {
            //     case "First":
            //         ele = $(that.ele + ' .playmode');
            //         if (ele.hasClass('real'))
            //             return;
            //         ele.click();
            //         break;
            //     case "Smooth":
            //         ele = $(that.ele + ' .playmode');
            //         if (!ele.hasClass('real'))
            //             return;
            //         ele.click();
            //         break;
            //     default:
            //         break;
            // }
            //判断是否空闲状态
            if (that.vediowindows[i].isfree && key != 'CLOSEALL')
                return;
            switch (key) {
                // 关闭所有车辆视频
                case "CLOSEALL":
                    that.stopAllVideo();
                    return;
                // 关闭
                case "CLOSE":
                    ele = $(that.ele + ' .tv_video_stop:eq(' + i + ')');
                    if (ele.css('display') != 'none')
                        ele.click();
                    return;
                // 关闭本车
                case "CLOSE_THE_CAR_VIDEO":

                    ele = $(that.ele + ' .tv_video_vehicle_stop:eq(' + i + ')');
                    if (ele.css('display') != 'none')
                        ele.click();
                    return;

                case "MianStream":

                    ele = $(that.ele + ' .tv_video_item_box_hd_main:eq(' + i + ')');
                    if (ele.css('display') != 'none')
                        ele.click();
                    return;
                case "SubStream":

                    ele = $(that.ele + ' .tv_video_item_box_hd_main_sub:eq(' + i + ')');
                    if (ele.css('display') != 'none')
                        ele.click();
                    break;
                case "SoundOpen":

                    ele = $(that.ele + ' .tv_video_item_sound_colse:eq(' + i + ')');
                    if (ele.css('display') != 'none')
                        ele.click();
                    break;
                case "SoundClose":

                    ele = $(that.ele + ' .tv_video_item_sound_open:eq(' + i + ')');
                    if (ele.css('display') != 'none')
                        ele.click();
                    break;
                case "Full":

                    ele = $(that.ele + ' .tv_video_item_box_full:eq(' + i + ')');
                    if (ele.css('display') != 'none')
                        ele.click();
                    break;
                case "Camera":

                    ele = $(that.ele + ' .tv_video_item_camera:eq(' + i + ')');
                    if (ele.css('display') != 'none')
                        ele.click();
                    break;

            }

        };

        typeof (context) != 'undefined' && context.init({
            preventDoubleContext: false
        });

        typeof (context) != 'undefined' && context.attach('.tv_video_item_box_video', [

            {
                text: sessionStorage.getItem('CLOSE'),
                action: function (e) {
                    videoContextClick(null, 'CLOSE', this.currentContextSelector);

                }
            },

            {
                text: sessionStorage.getItem('CLOSEALLVIDEO'),
                action: function (e) {
                    videoContextClick(null, 'CLOSEALL', this.currentContextSelector);

                }
            },
            {
                text: sessionStorage.getItem('CLOSE_THE_CAR_VIDEO') || '关闭本车视频',
                action: function (e) {
                    videoContextClick(null, 'CLOSE_THE_CAR_VIDEO', this.currentContextSelector);

                }
            },
            {
                text: sessionStorage.getItem('MAINSTREAM'),
                action: function (e) {
                    videoContextClick(null, 'MianStream', this.currentContextSelector);

                }
            },
            {
                text: sessionStorage.getItem('SUBSTREAM'),
                action: function (e) {
                    videoContextClick(null, 'SubStream', this.currentContextSelector);

                }
            },
            {
                text: sessionStorage.getItem('SOUND_OPEN'),
                action: function (e) {
                    videoContextClick(null, 'SoundOpen', this.currentContextSelector);

                }
            },
            {
                text: sessionStorage.getItem('SOUND_COLSE'),
                action: function (e) {
                    videoContextClick(null, 'SoundClose', this.currentContextSelector);

                }
            },
            {
                text: sessionStorage.getItem('SCREENSHOT'),
                action: function (e) {
                    videoContextClick(null, 'Camera', this.currentContextSelector);

                }
            },
            {
                text: sessionStorage.getItem('FULLSCREEN'),
                action: function (e) {
                    videoContextClick(null, 'Full', this.currentContextSelector);

                }
            },


        ]);




    },
};