/**
 * HowenVssVideoPlayer 视频播放器模块
 * @param ele 当前节点tr
 * @param wincount 初始化窗口数量
 * @param showTool 是否显示工具栏（分窗口数量/全部暂停...）
 * @param showontrol 是否控制栏
 * @param storageWinCount 是否存储video窗口展示数量
 * @param layero layer.open弹窗返回的dom对象，目前用于兼容AI标定功能
 */
function HowenVideoPlayer(ele, wincount, showTool, isOpenSound, showontrol, selectedChange, storageWinCount, layero) {
    // 获取 文件名
    let htmlName = window.location.pathname.match(/\/(\S*)\./)[1]
    // 本地存储的窗口展示数量
    let winCountName = htmlName + '_windowsCount'
    let localWincount = Number(localStorage.getItem(winCountName));
    // 优先使用本地存储的 窗口展示数量
    this.windowsCount = localWincount ? localWincount : wincount > 0 ? wincount : 4;
    this.showTool = showTool === false ? false : true;
    this.showontrol = showontrol === false ? false : true
    this.isOpenSound = isOpenSound === true ? true : false;
    this.storageWinCount = storageWinCount === true ? true : false;
    try {
        this.log = new Logger("HowenVideoPlayer");
    } catch (err) { }
    this.ele = ele;
    this.vediowindows = [];
    this.devices = [];
    this.httpsPortMaxCount = 800;
    this.httpsPorts = [];
    this.cameraData = "";
    this.loop = false;
    this.layero=layero;
    /*
    未知	0
    视频预览	1
    设备音频监听	2
    设备双向对讲	3
    设备录像回放	4
    设备录像联动回放	5
    设备录像下载 	6
    设备图片下载	7    HTTP
    设备音频文件下载	8    未找到设备支持语言文件       
    语音广播    9
    设备录像搜索	300
    设备图片搜索	301    HTTP 
    设备日志搜索	302
    设备音频文件搜索	303
    设备日志下载	304
    设备升级	305
    重启设备	306
    复位设备	307
    断油	308
    断油恢复	309
    断电	310
    断电恢复	311
    G-sensor校准	312
    发送文字到设备	313   HTTP 
    云台控制	314
    设备抓拍指令	315
    下发电子围栏	316   HTTP 
    设备参数配置	317
    */
    this.bussType = 0;
    //设置缓存时间 
    //读取配置里的，如果配置为空则为实时模式及缓存为0 默认流畅模式

    this.mBufferTimeMs = localStorage.getItem('BufferTimeMs') ? localStorage.getItem('BufferTimeMs') : 2000;
    this.PlayStream = localStorage.getItem('PlayStream') ? localStorage.getItem('PlayStream') : 0;
    this.isBackPlay = false;
    this.token = null;
    this.selectedChange = selectedChange;
    this.initData();
    this.initHtml();
    this.initVideoWindow();
    this.initEvent();


}

