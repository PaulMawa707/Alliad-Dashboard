    /**
     * 挨个选择窗口播放视频
     * @param url 播放地址
     * @param deviceno 设备编号
     * @param channel 通道
     * @param channelName 通道名称
     * @param ipserver 服务器地址
     * @param filename 当为告警录像时，记录当前正在播放的文件名称
     * @param devicename devicename
     */
    _playVideo: function (url, deviceno, channel, channelName, ipserver, filename, devicename) {

        let res = false;

        for (let index = 0; index < this.windowsCount; index++) {
            if (this.vediowindows[index].isfree || (this.vediowindows[index].deviceno == deviceno && this.vediowindows[index].channel == channel)) {

                if (!this.vediowindows[index].isfree) {
                    this.stop(index);
                }

                this.vediowindows[index].url = url;
                this.vediowindows[index].filename = filename;
                this.vediowindows[index].devicename = devicename;
                this.play(index, url, deviceno, channel, channelName, ipserver);
                res = true;
                break;
            }
        }
        return res;
    },

    /**
     * 这里更具当前的网络类型，是否需要将Http的连接转换为Https连接？
     * @param {url} url 需要播放视频流地址
     * @returns {url} 返回转换好的Url
     */
    changeHppts: function (url) {
        let that = this;
        let _url = url;
        let index = that.httpsPorts.findIndex((d) => d.count < that.httpsPortMaxCount);
        if (
            window.location.protocol.toLowerCase() === "https:".toLowerCase() &&
            _url.substring(_url.length - 4).toLowerCase() != ".mp4".toLowerCase()
        ) {
            if (_url.indexOf('alarmreplay') >= 0) {
                _url = _url.replace("alarmreplay?", "flvRouter.php?alarmreplay?");
            } else if (url.indexOf('slicereplay') >= 0) {
                temp_url = url.replace("slicereplay?", "flvRouter.php?_bywasm_slicereplay?");
            } else {
                _url = _url.replace("live?", "flvRouter.php?live?");
                _url = _url.replace("replay?", "flvRouter.php?replay?");
                _url = _url.replace("fastReplay?", "flvRouter.php?fastReplay?");
            }
            let temp = _url.split(/[/,:]/);

            if (index == -1) {
                let error = "http port 使用完毕，无法创建新的";
                that.log.logError(error);
                throw error;
            }

            //let _urls = `https://${window.location.hostname}:${that.httpsPorts[index].port}`;
            //let _urls = `https://172.16.50.210:${that.httpsPorts[index].port}`;
            //_url = _urls + "/" + _url.split(/[/,:]/)[5];
            //return _url;
            _url = _url.replace("http:", "https:");


        } else if (
            window.location.protocol.toLowerCase() === "https:".toLowerCase() &&
            _url.substring(_url.length - 4).toLowerCase() == ".mp4".toLowerCase()
        ) {
            _url = _url.replace("http:", "https:");
        }
        that.httpsPorts[index].count += 1;
        return _url;
    },
